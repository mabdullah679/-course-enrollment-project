spring:
  profiles:
    active: prod
  
  # Production datasource (placeholder - configure based on actual DB)
  datasource:
    url: ${DATABASE_URL:jdbc:postgresql://localhost:5432/cegm_gateway}
    username: ${DATABASE_USERNAME:gateway_user}
    password: ${DATABASE_PASSWORD}
    driver-class-name: org.postgresql.Driver
  
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  
  # Enable Liquibase in prod
  liquibase:
    enabled: true
    change-log: classpath:config/liquibase/master.xml
  
  # Security - JWT Resource Server (prod)
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${JWT_ISSUER_URI}
          jwk-set-uri: ${JWT_JWK_SET_URI}

# AWS SDK Configuration
aws:
  dynamodb:
    table-name: ${DDB_TABLE_NAME:cegm-gateway-table}
    region: ${AWS_REGION:us-east-1}
  ssm:
    region: ${AWS_REGION:us-east-1}

# Azure Cosmos DB Configuration  
azure:
  cosmos:
    endpoint: ${COSMOS_ENDPOINT}
    key: ${COSMOS_KEY}
    database: ${COSMOS_DATABASE:cegm-gateway-db}
    container: ${COSMOS_CONTAINER:gateway-container}

# Actuator - expose health and info only
management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: never

# CORS for staging frontend
cors:
  allowed-origins:
    - ${FRONTEND_STAGING_URL:https://staging-frontend.example.com}
    - ${FRONTEND_PROD_URL:https://app.example.com}
  allowed-methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allowed-headers: "*"
  allow-credentials: true

# Springdoc OpenAPI - disabled in prod
springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false

# Logging
logging:
  level:
    com.cegm.gateway: INFO
    org.springframework.web: WARN
    org.hibernate.SQL: WARN
  pattern:
    console: "%d{ISO8601} [%thread] %-5level [%X{requestId}] %logger{36} - %msg%n"
