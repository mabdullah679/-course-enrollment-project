spring:
  profiles:
    active: dev
  
  # H2 Database for development
  datasource:
    url: jdbc:h2:mem:testdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
    username: sa
    password: 
    driver-class-name: org.h2.Driver
  
  h2:
    console:
      enabled: true
      path: /h2-console
  
  jpa:
    database-platform: org.hibernate.dialect.H2Dialect
    hibernate:
      ddl-auto: create-drop
    show-sql: true
    properties:
      hibernate:
        format_sql: true
  
  # Disable Liquibase in dev
  liquibase:
    enabled: false
  
  # Security - JWT Resource Server (dev keys)
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: https://dev-auth.example.com
          jwk-set-uri: https://dev-auth.example.com/.well-known/jwks.json

# Actuator - expose health and info only
management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: when-authorized

# CORS for dev frontend
cors:
  allowed-origins:
    - http://localhost:3000
    - http://localhost:4200
  allowed-methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allowed-headers: "*"
  allow-credentials: true

# Springdoc OpenAPI - enabled in dev
springdoc:
  api-docs:
    enabled: true
    path: /v3/api-docs
  swagger-ui:
    enabled: true
    path: /swagger-ui.html

# Logging
logging:
  level:
    com.cegm.gateway: DEBUG
    org.springframework.web: DEBUG
    org.hibernate.SQL: DEBUG
