{ "budget_profiles": { "free_first": { "aws": { "compute": "lambda","endpoint": "lambda_function_url","db": "dynamodb_provisioned_low","cdn": "cloudfront","forbidden": ["nat_gateway"],"discouraged": ["api_gateway"],"notes": ["Lambda Always Free limits apply","DynamoDB 25GB, 25 RCU, 25 WCU per region","CloudFront Always Free allowances apply","100 GB data transfer out from Regions per month"] }, "gcp": { "compute": "cloud_run_min_zero","db": "firestore_native","cdn": "cloud_cdn","notes": ["use min_scale 0"] } } }, "hard_fails": [ { "when": "provider=aws AND budget=free_first AND use_api_gateway=true", "message": "API Gateway is not Always Free after month 12. Use Lambda Function URL or change budget profile." }, { "when": "provider=aws AND region IN [us-gov*, cn-*]", "message": "GovCloud or China BJS not supported by Free Tier. Use a supported region or change profile." } ], "advisories": [ { "when": "provider=aws AND s3_static=true", "message": "S3 Standard 12-month free only. After 12 months treat S3 as paid." }, { "when": "provider=aws AND wants_nat_gateway=true", "message": "NAT Gateway has hourly and per-GB costs. Prefer Gateway VPC Endpoints for S3 and DynamoDB." } ], "defaults": { "aws": { "lambda": { "memory_mb": 128, "timeout_seconds": 10, "reserved_concurrency": null }, "dynamodb": { "table_class": "STANDARD", "rcu": 1, "wcu": 1, "ttl_attribute": "expiresAt" }, "cloudwatch_caps": { "custom_metrics": 10, "alarms": 10, "log_ingest_gb": 5 } }, "gcp": { "cloud_run": { "cpu": 1, "memory_mb": 256, "min_scale": 0, "max_scale": 2, "timeout_seconds": 10 } } } }
