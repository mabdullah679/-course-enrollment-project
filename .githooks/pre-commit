#!/bin/bash

# Pre-commit hook for CEGM project
# This hook performs security checks and prevents committing sensitive data

set -e

echo "🔍 Running pre-commit security checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Flag to track if any violations are found
VIOLATIONS=0

# Function to report violations
report_violation() {
    echo -e "${RED}❌ VIOLATION:${NC} $1"
    VIOLATIONS=1
}

# Function to report warnings
report_warning() {
    echo -e "${YELLOW}⚠️  WARNING:${NC} $1"
}

# Check for hardcoded secrets in staged files
echo "🔒 Checking for hardcoded secrets..."

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Check for password patterns in Java files
if echo "$STAGED_FILES" | grep -E '\.(java|properties|yaml|yml)$' | xargs grep -l "password.*=" 2>/dev/null; then
    report_violation "Hardcoded passwords found in staged files"
fi

# Check for API keys
if echo "$STAGED_FILES" | xargs grep -iE "(api_key|secret_key|access_key)" 2>/dev/null; then
    report_violation "API keys or secret keys found in staged files"
fi

# Check for AWS credentials
if echo "$STAGED_FILES" | xargs grep -iE "(aws_access_key|aws_secret|AKIA)" 2>/dev/null; then
    report_violation "AWS credentials found in staged files"
fi

# Check for localhost references in Java source code (but allow in config files)
echo "🌐 Checking for hardcoded localhost references..."
if echo "$STAGED_FILES" | grep '\.java$' | xargs grep -l "localhost" 2>/dev/null; then
    report_violation "Hardcoded localhost found in Java source files"
fi

# Check for hardcoded ports in Java code
echo "🔌 Checking for hardcoded ports..."
if echo "$STAGED_FILES" | grep '\.java$' | xargs grep -E ":[0-9]{4,5}" 2>/dev/null; then
    report_violation "Hardcoded ports found in Java source files"
fi

# Check for TODO/FIXME in production code (warning only)
echo "📝 Checking for TODO/FIXME comments..."
if echo "$STAGED_FILES" | grep '\.java$' | xargs grep -iE "(TODO|FIXME)" 2>/dev/null; then
    report_warning "TODO/FIXME comments found - consider addressing before production"
fi

# Check for debug statements
echo "🐛 Checking for debug statements..."
if echo "$STAGED_FILES" | grep '\.java$' | xargs grep -E "(System\.out\.print|System\.err\.print|printStackTrace)" 2>/dev/null; then
    report_warning "Debug print statements found - consider using proper logging"
fi

# Check for sensitive file extensions
echo "📁 Checking for sensitive file types..."
SENSITIVE_EXTENSIONS=".key .pem .p12 .jks .keystore .env"
for ext in $SENSITIVE_EXTENSIONS; do
    if echo "$STAGED_FILES" | grep -E "\$ext$" 2>/dev/null; then
        report_violation "Sensitive file type ($ext) found in staged files"
    fi
done

# Check SSoT files if they exist and are being modified
if echo "$STAGED_FILES" | grep -E "ssot/.*\.(yaml|yml|json)$" >/dev/null 2>&1; then
    echo "🔧 Validating SSoT files..."
    if [[ -f "scripts/validate-ssot.sh" ]]; then
        if ! ./scripts/validate-ssot.sh >/dev/null 2>&1; then
            report_violation "SSoT validation failed"
        fi
    else
        report_warning "SSoT validation script not found"
    fi
fi

# Check for proper commit message format (if not an automated commit)
COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"
if [[ -f "$COMMIT_MSG_FILE" ]]; then
    COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")
    if [[ ! "$COMMIT_MSG" =~ ^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .+ ]]; then
        report_warning "Commit message doesn't follow conventional commit format"
        echo "  Expected: type(scope): description"
        echo "  Examples: feat(auth): add JWT authentication"
        echo "           fix(api): resolve course enrollment bug"
        echo "           docs: update API documentation"
    fi
fi

# Final verdict
if [[ $VIOLATIONS -eq 1 ]]; then
    echo
    echo -e "${RED}🚫 Pre-commit hook failed due to security violations.${NC}"
    echo -e "${RED}   Please fix the issues above and try again.${NC}"
    echo
    echo "If you need to override this check (NOT RECOMMENDED), run:"
    echo "  git commit --no-verify"
    echo
    exit 1
else
    echo
    echo -e "${GREEN}✅ Pre-commit security checks passed.${NC}"
    echo
    exit 0
fi
