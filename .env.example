# Copy to .env (gitignored) and fill in. Placeholders only; never commit real values.
# Real dev values: AWS SSM Parameter Store, us-east-1, SecureString:
#   /mab-site/dev/course-enrollment/admin-password
#   /mab-site/dev/course-enrollment/student-password
# If a variable is unset/blank, the backend does NOT create that user and logs a WARN.
SEED_ADMIN_PASSWORD=<set-me>
SEED_STUDENT_PASSWORD=<set-me>
